      "apiKeyEnv": "GATEWAY_GPT_API_KEY",
      "models": [
        "gpt-5.6-sol",
        "gpt-5.6-terra",
        "gpt-5.6-luna",
        "gpt-5.5"
      ],
      "modelProfiles": {
        "gpt-5.6-sol": {
          "displayName": "GPT 5.6 Sol",
          "reasoningEfforts": ["low", "medium", "high", "xhigh"],
