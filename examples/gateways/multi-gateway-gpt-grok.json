        "gpt-5.6-terra": {
          "displayName": "GPT 5.6 Terra",
          "reasoningEfforts": ["low", "medium", "high", "xhigh"],
          "serviceTiers": ["priority"]
        },
        "gpt-5.6-luna": {
          "displayName": "GPT 5.6 Luna",
          "reasoningEfforts": ["low", "medium", "high"],
          "serviceTiers": ["priority"]
        },
        "gpt-5.5": {
          "displayName": "GPT 5.5",
          "reasoningEfforts": ["low", "medium", "high", "xhigh"],
          "serviceTiers": ["priority"]
