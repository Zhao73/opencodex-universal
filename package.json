{
  "name": "opencodex-universal",
  "version": "0.1.0-preview.2",
  "description": "Paste an API key, get every model it unlocks \u2014 a multi-gateway model router for Codex, Claude Code, and OpenCode with one-paste Sub2API / One API / New API onboarding.",
  "type": "module",
  "main": "./bin/package-main.mjs",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "default": "./bin/package-main.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "opencodex": "./bin/ocx.mjs",
    "ocx": "./bin/ocx.mjs",
    "opencodex-universal": "./bin/ocx.mjs",
    "ocxu": "./bin/ocx.mjs"
  },
  "files": [
    "bin",
    "src",
    "gui/dist",
    "assets/banner.png",
    "assets/architecture.png",
    "assets/codex-app-picker.png",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "trustedDependencies": [
    "bun"
  ],
  "scripts": {
    "dev": "bun run src/cli/index.ts start",
    "dev:proxy": "bun run src/cli/index.ts start",
    "dev:gui": "cd gui && bun run dev",
    "start": "bun run src/cli/index.ts start",
    "test": "bun scripts/test.ts",
    "typecheck": "bun x tsc --noEmit",
    "privacy:scan": "bun scripts/privacy-scan.ts",
    "generate:jawcode-metadata": "bun scripts/generate-jawcode-metadata.ts",
    "build:gui": "cd gui && bun install --frozen-lockfile && bun run build && cd .. && bun run prepare:package",
    "build:release-assets": "bun scripts/build-release-assets.ts",
    "prepare:package": "bun scripts/prepare-package.ts",
    "prepack": "bun run prepare:package",
    "prepublishOnly": "bun run typecheck && bun run build:gui",
    "release": "bun scripts/release.ts",
    "release:watch": "bun scripts/release.ts watch",
    "prepush": "bun run typecheck && bun run lint:gui && bun run test && bun run privacy:scan && bun run doctor:gui:if-changed",
    "lint:gui": "cd gui && bun run lint",
    "doctor:gui": "cd gui && bun run doctor",
    "doctor:gui:full": "cd gui && bun run doctor:full",
    "doctor:gui:if-changed": "bun scripts/doctor-gui-if-changed.ts",
    "setup:hooks": "bun scripts/setup-hooks.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@modelcontextprotocol/sdk": "^1",
    "bun": "1.3.14",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "overrides": {
    "fast-uri": "^3.1.4"
  },
  "keywords": [
    "codex",
    "openai",
    "proxy",
    "llm",
    "ollama",
    "anthropic",
    "responses-api",
    "claude-code",
    "claude",
    "codex-cli",
    "gemini",
    "grok",
    "deepseek",
    "chatgpt",
    "llm-proxy",
    "ai-gateway",
    "openrouter",
    "sub2api",
    "one-api",
    "new-api",
    "opencode",
    "api-gateway",
    "model-router",
    "codex-app",
    "gpt-5",
    "grok-4",
    "multi-provider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhao73/opencodex-universal.git"
  },
  "homepage": "https://github.com/Zhao73/opencodex-universal#readme",
  "bugs": {
    "url": "https://github.com/Zhao73/opencodex-universal/issues"
  },
  "license": "MIT"
}
